# Disable PHP execution in uploads directory (using FilesMatch deny below instead of php_flag which causes 403/500 on InfinityFree)


# Prevent viewing files directly as executable scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|sh|bat|cmd|exe|com|asp|aspx|jsp|jspx|shtml|shtm|html|htm|js|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes
